TELEGRAM_BOT_TOKEN=...
GROQ_API_KEY=...
# Ixtiyoriy: suhbat AI ga yuborilsinmi? false = hech qanday ma'lumot tashqariga chiqmaydi, faqat o'rgatilgan javoblar (default: true)
# JARVIS_GROQ_ALLOWED=false
# Ixtiyoriy: faqat shu ID botdan foydalashi mumkin (default: 2109017495)
JARVIS_ALLOWED_TELEGRAM_ID=2109017495
# Ixtiyoriy: bot paroli (default: 197o)
JARVIS_BOT_PASSWORD=197o
# Ixtiyoriy: Cursor ochilganda ochiladigan papka — Python loyihasi (prompt shu papkada)
JARVIS_CURSOR_WORKSPACE=C:\Users\Пользователь\OneDrive\Documents\GitHub\Muh-said\python
# Ixtiyoriy: "ai och" / "prompt ..." — ChatGPT linki va qaysi Chrome hisobida (MS, SHMS, SOLIH, SODIQ)
# JARVIS_CHATGPT_URL=https://chatgpt.com/
# JARVIS_AI_CHROME_ACCOUNT=MS
# Ixtiyoriy: "yutub och" — YouTube ilova yo'li (default: Desktop\YouTube)
# JARVIS_YOUTUBE_APP=C:\Users\...\Desktop\YouTube