      "webhook_path": "/webhook/loveble",
      "request_method": "POST",
      "content_type": "application/json",
      "signature_header": "X-Loveble-Signature",
      "signature_algorithm": "HMAC-SHA256",
      "signature_encoding": "hexadecimal"
    },

    "required_events": [
      {
        "event_type": "order_paid",
        "description": "When customer paid for order",
        "required": true,
        "process_by_bot": true
      },
      {
        "event_type": "order_completed",
        "description": "When order is completed",
        "required": true,
        "process_by_bot": true
      },
      {
        "event_type": "order_created",
        "description": "When order is created (before payment)",
        "required": false,
        "process_by_bot": false
      }
    ],

    "required_from_loveble": [
      "shop_id",
      "api_key",
      "webhook_secret",
      "product_ids (8 items)",
      "test_webhook_capability"
    ],

    "webhook_payload_format": {
