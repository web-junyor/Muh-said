        {
          "product_id": "string - product ID from Loveble",
          "product_name": "string - Cappuccino",
          "quantity": "number - 2",
          "price": "number - 7000 (som per unit)",
          "total_price": "number - 14000 (quantity * price)"
        }
      ],
      "total_amount": "number - sum of all items",
      "payment_status": "string - paid/completed",
      "payment_method": "string - card/cash",
      "customer_phone": "optional string - +998901234567"
